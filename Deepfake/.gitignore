test_stroke_pipeline.py
*.log
logs/
temp/
tmp/

# ---------------------------------------------------------------------
# 7. Operating System & IDE Specific Files
# ---------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

