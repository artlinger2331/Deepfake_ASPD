# ---------------------------------------------------------------------
# 1. Python & Virtual Environments
# ---------------------------------------------------------------------
venv/
venv*/
.venv/
.venv*/
env/
env*/
**/venv/
**/venv*/
**/venv_gpu/
**/.venv/
ENV/
env.bak/
venv.bak/

# ---------------------------------------------------------------------
# 2. Python Bytecode, Caching & Build Artifacts
# ---------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------
# 3. Node.js & Vite Frontend
# ---------------------------------------------------------------------
node_modules/
**/node_modules/
**/node_modules/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
**/dist/
dist-ssr/
*.local
.vite/
**/.vite/
**/.vite/**

# ---------------------------------------------------------------------
